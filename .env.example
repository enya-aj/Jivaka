# Compose profiles to activate. "ollama-managed" starts the bundled `ollama`
# + `ollama-pull` services (the default — a fresh host with no Ollama of its
# own). If this host already runs Ollama natively or elsewhere, clear this
# var, don't set OLLAMA_MODEL to something not yet pulled there, and point
# OLLAMA_HOST at that instance instead (e.g.
# http://host.docker.internal:11434 for a native service on the same host).
COMPOSE_PROFILES=ollama-managed

# Host ports published for this deployment. Change these if they collide
# with something else already running on the host.
FALKOR_PORT=6379
FALKOR_UI_PORT=3000
BACKEND_PORT=8000
# Host address FalkorDB (6379 + browser UI) and the bundled Ollama listen on.
# Keep 127.0.0.1 unless the host is on a private network: neither has a
# password. The backend container reaches them over the compose network.
FALKOR_BIND_ADDRESS=127.0.0.1

# FalkorDB
FALKOR_HOST=falkordb
FALKOR_GRAPH_NAME=jivaka

# Ollama
OLLAMA_HOST=http://ollama:11434
# No default model is set on purpose — pick a model you have pulled/can pull,
# e.g. llama3.1 or a medical-tuned variant, and set it here. If reusing an
# existing Ollama instance (COMPOSE_PROFILES cleared above), it must already
# have this model pulled.
OLLAMA_MODEL=
# How long to wait for one chunk's extraction call before giving up. On a
# shared/contended Ollama instance (e.g. someone else's `ollama run` session
# competing for the same CPU-bound model) a request can queue for a while -
# too short a timeout here is swallowed per-chunk and silently yields 0
# entities for that chunk instead of a visible failure.
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# Ingestion
DEFINITION_SOURCE=stub
UPLOAD_DIR=/app/data/uploads
# Approximate chars-per-pixel-squared threshold below which a page is treated
# as scanned/low-text and routed to OCR. Placeholder value pending tuning
# against real sample documents.
OCR_TEXT_DENSITY_THRESHOLD=0.005
# Most chunk extractions sent to Ollama at once, across all running ingests.
# They only truly run side by side if Ollama allows it (OLLAMA_NUM_PARALLEL
# on the Ollama side); otherwise the extra one waits in Ollama's queue, which
# still keeps the model busy while results are written to the graph.
INGEST_MAX_CONCURRENCY=2
# Extra attempts for a chunk whose extraction failed before it is stored
# with no entities (counted as failed_chunks in the ingest result).
INGEST_EXTRACTION_RETRIES=1
# Chunk sizes in characters. Bigger chunks mean fewer LLM calls for a large
# document. Changing them makes interrupted ingests start their file over.
TEXTBOOK_CHUNK_MAX_CHARS=1500
PATIENT_RECORD_CHUNK_MAX_CHARS=1200

# Which LLM extracts entities during ingestion: "ollama" (local, default) or
# "openrouter" (cloud API at openrouter.ai; much faster for very large
# documents, paid per token). Chat always uses Ollama.
INGEST_LLM_PROVIDER=ollama
# Your key from https://openrouter.ai/keys. Keep it only in .env, never commit it.
OPENROUTER_API_KEY=
# e.g. google/gemini-2.5-flash-lite (needs JSON mode support).
OPENROUTER_MODEL=
# Extractions sent to OpenRouter at once (replaces INGEST_MAX_CONCURRENCY
# for OpenRouter ingests). Lower it if you see many 429 rate-limit retries.
OPENROUTER_MAX_CONCURRENCY=16
# Only use OpenRouter providers that don't store or train on prompts.
OPENROUTER_DENY_DATA_COLLECTION=true
# Patient records keep using Ollama unless this is true, even when
# INGEST_LLM_PROVIDER=openrouter. They are de-identified first, but
# de-identification is not perfect.
OPENROUTER_FOR_PATIENT_RECORDS=false

# Patient record de-identification. Keep NER on: without it only the
# rule-based recognizers run and free-text names slip through.
DEID_USE_NER=true
# Extra hospital ID formats as a JSON list of regexes; matches become [ID].
# e.g. DEID_EXTRA_ID_PATTERNS=["\\b\\d{2}-\\d{6}\\b"]
DEID_EXTRA_ID_PATTERNS=[]

# Chat: how many chunks are given to the model as sources per answer.
RETRIEVAL_TOP_K=6
