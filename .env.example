# Compose profiles to activate. "ollama-managed" starts the bundled `ollama`
# + `ollama-pull` services (the default — a fresh host with no Ollama of its
# own). If this host already runs Ollama natively or elsewhere, clear this
# var, don't set OLLAMA_MODEL to something not yet pulled there, and point
# OLLAMA_HOST at that instance instead (e.g.
# http://host.docker.internal:11434 for a native service on the same host).
COMPOSE_PROFILES=ollama-managed

# Host ports published for this deployment. Change these if they collide
# with something else already running on the host.
FALKOR_PORT=6379
FALKOR_UI_PORT=3000
BACKEND_PORT=8000

# FalkorDB
FALKOR_HOST=falkordb
FALKOR_GRAPH_NAME=jivaka

# Ollama
OLLAMA_HOST=http://ollama:11434
# No default model is set on purpose — pick a model you have pulled/can pull,
# e.g. llama3.1 or a medical-tuned variant, and set it here. If reusing an
# existing Ollama instance (COMPOSE_PROFILES cleared above), it must already
# have this model pulled.
OLLAMA_MODEL=

# Ingestion
DEFINITION_SOURCE=stub
UPLOAD_DIR=/app/data/uploads
# Approximate chars-per-pixel-squared threshold below which a page is treated
# as scanned/low-text and routed to OCR. Placeholder value pending tuning
# against real sample documents.
OCR_TEXT_DENSITY_THRESHOLD=0.005
